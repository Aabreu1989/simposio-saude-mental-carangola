rules_version = '2';
service firebase.storage {
  match /b/{bucket}/o {

    function isSignedIn() {
      return request.auth != null;
    }

    function isAdmin() {
      return isSignedIn() &&
        request.auth.token.email_verified == true &&
        request.auth.token.email in ['farmaciademinas.marketing@gmail.com', 'amandajhonnes@yahoo.com.br'];
    }

    // Default deny all
    match /{allPaths=**} {
      allow read, write: if false;
    }

    // Fotografias anexadas ao Social Wall (Mural Coletivo)
    match /social_posts/{postId}/{fileName} {
      // Leitura pública das fotos do mural
      allow read: if true;

      // Criação de foto: imagem válida (jpeg, png, webp) até 5MB
      allow create: if request.resource.size <= 5 * 1024 * 1024 &&
        request.resource.contentType.matches('image/(jpeg|jpg|png|webp)') &&
        postId.size() >= 1 && postId.size() <= 128 &&
        fileName.size() >= 1 && fileName.size() <= 160;

      // Atualização e exclusão de fotos restrita a administradores autenticados
      allow update, delete: if isAdmin();
    }
  }
}
